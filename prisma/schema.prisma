// GlobeTrotter — personalized multi-city travel planner.
// Calendar dates (trip/stop/item) are stored as DateTime pinned to UTC midnight
// so date-only comparisons never drift by timezone. See docs/DECISIONS.md D-03.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ActivityCategory {
  SIGHTSEEING
  FOOD
  ADVENTURE
  CULTURE
  NIGHTLIFE
  SHOPPING
  NATURE
  OTHER
}

enum ExpenseCategory {
  TRANSPORT
  STAY
  MEALS
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  photoUrl      String? // base64 data URL, <= 2 MB
  languagePref  String?   @default("en")
  resetToken    String?   @unique
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trips             Trip[]
  savedDestinations SavedDestination[]
  activityLogs      ActivityLog[]
  notifications     Notification[]

  @@index([role])
  @@index([createdAt])
}

// ─── Master catalog: the app's data source (no external travel APIs) ───

model City {
  id          String  @id @default(cuid())
  name        String
  country     String
  region      String
  costIndex   Int // 1-100, relative daily cost of being here
  popularity  Int // 0-100, drives recommendations + default sort
  description String?
  imageUrl    String?

  activities        Activity[]
  stops             Stop[]
  savedDestinations SavedDestination[]

  @@unique([name, country])
  @@index([popularity])
  @@index([region])
  @@index([country])
}

model Activity {
  id            String           @id @default(cuid())
  cityId        String
  city          City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name          String
  category      ActivityCategory
  cost          Decimal          @db.Decimal(10, 2)
  durationHours Decimal          @db.Decimal(4, 1)
  description   String?
  imageUrl      String?

  itineraryItems ItineraryItem[]

  @@index([cityId])
  @@index([category])
  @@index([cost])
}

// ─── Trip planning ───

model Trip {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  coverPhotoUrl  String? // base64 data URL, <= 2 MB
  budgetTotal    Decimal? @db.Decimal(12, 2) // set => over-budget alerts turn on
  isPublic       Boolean  @default(false)
  publicSlug     String?  @unique // retained after un-share so re-sharing reuses the link
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stops Stop[]

  @@index([userId, startDate])
  @@index([createdAt])
}

model Stop {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  startDate DateTime
  endDate   DateTime
  order     Int
  notes     String?

  items    ItineraryItem[]
  expenses Expense[]

  @@index([tripId, order])
  @@index([cityId])
}

model ItineraryItem {
  id           String    @id @default(cuid())
  stopId       String
  stop         Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activityId   String
  activity     Activity  @relation(fields: [activityId], references: [id])
  date         DateTime
  startTime    String? // "HH:mm"
  costOverride Decimal?  @db.Decimal(10, 2) // per-trip price edit; never mutates the catalog
  notes        String?
  order        Int       @default(0) // position within its day

  @@index([stopId, date, order])
  @@index([activityId])
}

model Expense {
  id          String          @id @default(cuid())
  stopId      String
  stop        Stop            @relation(fields: [stopId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime? // null => attributed to the trip start date in the per-day series
  createdAt   DateTime        @default(now())

  @@index([stopId, category])
}

model SavedDestination {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cityId])
  @@index([userId])
}

// ─── Light audit trail (trip created / shared / copied) ───

model ActivityLog {
  id         String   @id @default(cuid())
  action     String // TRIP_CREATED, TRIP_SHARED, TRIP_COPIED
  entityType String
  entityId   String
  message    String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
