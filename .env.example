# Copy to .env — never commit real values

# Neon Postgres — use the POOLED connection string from the Neon dashboard
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Set on Vercel too; not needed locally in most setups:
# AUTH_URL="https://your-app.vercel.app"

# Email (optional — app runs fine without; sendEmail() no-ops with a warning)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""   # Gmail app password
EMAIL_FROM="Procurement App <you@gmail.com>"
